<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>DeskMCP</AssemblyName>
    <RootNamespace>DeskMCP.ControlPanel</RootNamespace>
    <Version>0.9.18</Version>
    <AssemblyVersion>0.9.18.0</AssemblyVersion>
    <FileVersion>0.9.18.0</FileVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>..\..\assets\brand\DeskMCP.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="locales\en-US.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="locales\zh-TW.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Panel.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="..\..\assets\brand\deskmcp-mark-64.png" Link="brand\deskmcp-mark-64.png"/>
    <EmbeddedResource Include="..\..\assets\brand\DeskMCP.ico" LogicalName="DeskMCP.Brand.DeskMCP.ico"/>
  </ItemGroup>
</Project>